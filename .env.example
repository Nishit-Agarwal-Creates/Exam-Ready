# ExamReady environment variables. See README → Environment variables.
# Local development reads secrets from .dev.vars (created automatically by `npm run dev`).
# In production, set secrets with `npx wrangler secret put <NAME>` and plain vars in wrangler.jsonc.
# Never commit real values.

# Secret: admin sign-in password (at least 8 characters)
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret: signs the admin session cookie (at least 32 characters)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-characters

# Public site URL, used for canonical links and the sitemap (wrangler.jsonc vars)
SITE_URL=https://your-domain.example

# Same URL, needed at build time for pre-rendered pages
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# "false" hides demo questions from papers and public pages (wrangler.jsonc vars)
SHOW_DEMO_DATA=true
